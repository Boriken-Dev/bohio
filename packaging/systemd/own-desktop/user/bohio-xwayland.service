# The own desktop's X server: Xwayland as a window that fills the compositor's output, so it is a whole X screen (its
# root window can be read, and XTest, the extension the node's input goes through, drives it). Its display is `:UID`
# (%U), the one the node derives from its own uid; two accounts on one host never share a name.
#
# A client needs the account's identity to connect: the server admits its own account alone (the default access
# control, the server-interpreted `localuser` of the account that started it), and the node, started as that account,
# is one. Programs the account runs in this desktop use DISPLAY=:UID.

[Unit]
Description=Bohio own desktop: X server on display :%U
ConditionUser=@ACCOUNT@
Requires=bohio-compositor.service
BindsTo=bohio-compositor.service
After=bohio-compositor.service
PartOf=bohio-desktop.target

[Service]
Type=simple
UnsetEnvironment=DISPLAY
ExecStart=/bin/sh -c 'WAYLAND_DISPLAY=$$(cat "%t/bohio-wayland-display") exec /usr/bin/Xwayland :%U -fullscreen -geometry 1280x720 -noreset -nolisten tcp'
ExecStartPost=/bin/sh -c 'i=0; while ! grep -q "@/tmp/.X11-unix/X%U$$" /proc/net/unix && [ "$$i" -lt 100 ]; do sleep 0.1; i=$$((i + 1)); done; grep -q "@/tmp/.X11-unix/X%U$$" /proc/net/unix'
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077
